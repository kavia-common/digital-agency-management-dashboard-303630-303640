# Backend base URL (preferred)
REACT_APP_API_BASE_URL=http://localhost:3001

# Alternative base URL env supported by container config (either is fine)
REACT_APP_BACKEND_URL=http://localhost:3001

# API mode: 'real' (default) or 'stub'
REACT_APP_API_MODE=real

# Optional: used for Supabase email redirect (backend uses SITE_URL); kept for future
REACT_APP_SITE_URL=http://localhost:3000
